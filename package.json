{
  "name": "aura-music",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd apps/web-player dev",
    "build": "bun run typecheck && bun run --cwd apps/web-player build",
    "preview": "bun run --cwd apps/web-player preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests"
  },
  "dependencies": {},
  "devDependencies": {
    "@aura-music/background": "workspace:*",
    "@aura-music/core": "workspace:*",
    "@aura-music/lyrics": "workspace:*",
    "@aura-music/player": "workspace:*",
    "@aura-music/view": "workspace:*",
    "@aura-music/visualizer": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "ws": "^8.21.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
