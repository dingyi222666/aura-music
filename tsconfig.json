{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "bun"
    ],
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "apps",
    "packages",
    "tests",
    "env.d.ts"
  ],
  "exclude": [
    "**/dist",
    "node_modules"
  ]
}
